---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Not found" prompt="~/404" noindex>
  <main id="main" class="col">
    <section class="sec first">
      <p class="cmd"><span class="ps">$</span> cd missing</p>
      <h1>404 — not found</h1>
      <p class="prose">That page doesn’t exist, or it hasn’t been published yet.</p>
      <p><a class="more" href="/">cd ~ →</a></p>
    </section>
  </main>
</Base>
