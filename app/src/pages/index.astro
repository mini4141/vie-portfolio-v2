---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getProfile, listFeatured, listPublished, mediaUrl } from '../lib/queries.ts';
import { slugify, safeUrl } from '../lib/text.ts';

const p = getProfile();
const featured = listFeatured();
const total = listPublished().length;
const sections = p.sections.filter((s) => s.visible);
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const paragraphs = p.about.split(/\n\s*\n/).filter(Boolean);
---
<Base>
  <main id="main" class="col">
    <section class="hero">
      <div>
        <p class="cmd reveal">Hi, I’m</p>
        <h1 class="reveal" style="--d:1">{p.name}</h1>
        <p class="headline reveal" style="--d:2">{p.headline}</p>
        {p.status_line && <p class="status reveal" style="--d:2"><span class="ok"></span>{p.status_line}</p>}
        <div class="cta reveal" style="--d:3">
          <a class="btn btn-primary" href="#work">See my work <Icon name="out" /></a>
          <a class="btn" href="#contact">Contact me</a>
        </div>
      </div>
      {p.photo_file && (
        <div class="reveal" style="--d:2">
          <div class="win hero-win">
            <div class="win-bar"><i></i><i></i><i></i></div>
            <img src={mediaUrl(p.photo_file)} alt={p.photo_alt} fetchpriority="high">
          </div>
        </div>
      )}
    </section>

    {sections.map((s) => {
      if (s.key === 'about' && p.about) return (
        <section class="sec" id="about">
          <h2 class="reveal">About</h2>
          <div class="prose reveal">{paragraphs.map((t) => <p>{t}</p>)}</div>
          {p.location && <p class="muted small reveal">Based in {p.location}</p>}
        </section>
      );
      if (s.key === 'featured' && featured.length) return (
        <section class="sec" id="work">
          <h2 class="reveal">Selected projects</h2>
          <div class="cards">
            {featured.map((pr, i) => (
              <article class="card-p reveal" style={`--d:${i % 2}`}>
                <a href={`/projects/${pr.slug}`} tabindex="-1" aria-hidden="true">
                  <div class="win"><div class="win-bar"><i></i><i></i><i></i></div>{pr.cover_file && <img src={mediaUrl(pr.cover_file)} alt="" loading="lazy" />}</div>
                </a>
                <h3><a href={`/projects/${pr.slug}`}>{pr.title}</a></h3>
                <p>{pr.summary}</p>
                <p class="tags">{pr.tags.map((t) => <span>#{slugify(t)}</span>)}</p>
              </article>
            ))}
          </div>
          <p class="reveal"><a class="more" href="/projects">See all {total} {total === 1 ? 'project' : 'projects'} →</a></p>
        </section>
      );
      if (s.key === 'skills' && p.skills.length) return (
        <section class="sec" id="skills">
          <h2 class="reveal">Skills</h2>
          <dl class="kv reveal">
            {p.skills.map((g) => <div><dt>{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>)}
          </dl>
        </section>
      );
      if (s.key === 'experience' && p.experience.length) return (
        <section class="sec" id="experience">
          <h2 class="reveal">Experience</h2>
          <ol class="log">
            {p.experience.map((j, i) => (
              <li class="reveal">
                <span class="yr">{j.years}</span>
                <div><strong>{j.role}</strong> @ {j.org} {i === 0 && <span class="head">Current</span>}<p class="muted">{j.text}</p></div>
              </li>
            ))}
          </ol>
        </section>
      );
      if (s.key === 'contact') return (
        <section class="sec" id="contact">
          <h2 class="reveal">Contact</h2>
          <div class="reveal">
            {p.email && <a class="email" href={`mailto:${p.email}`}>{p.email}</a>}
            <ul class="links">
              {p.links.filter((l) => safeUrl(l.url)).map((l) => <li><a href={safeUrl(l.url)} rel="noopener"><Icon name={/github/i.test(l.label) ? 'github' : 'link'} /> {host(l.url)}</a></li>)}
              {p.cv_file && <li><a href={mediaUrl(p.cv_file)} download><Icon name="download" /> {p.cv_file}</a></li>}
            </ul>
          </div>
        </section>
      );
      return null;
    })}
  </main>
</Base>
