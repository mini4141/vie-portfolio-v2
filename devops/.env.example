# Copy to devops/.env (gitignored). Used by docker-compose.yml.
SITE_DOMAIN=localhost
# Only needed on the very first start (fills the empty database). Use a long unique password.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-before-first-start

# Continuous backup (docker compose --profile backup up -d)
LITESTREAM_BUCKET=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
