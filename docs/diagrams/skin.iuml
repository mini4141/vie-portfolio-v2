!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #44504A
skinparam ArrowFontSize 11
skinparam DefaultTextAlignment center
skinparam RectangleBackgroundColor #F4F8F6
skinparam RectangleBorderColor #12805C
skinparam NodeBackgroundColor #F4F8F6
skinparam NodeBorderColor #12805C
skinparam DatabaseBackgroundColor #FFF6E5
skinparam DatabaseBorderColor #B7791F
skinparam CloudBackgroundColor #EAF2FB
skinparam CloudBorderColor #2B6CB0
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #12805C
skinparam QueueBackgroundColor #FDECEC
skinparam QueueBorderColor #C53030
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #44504A
skinparam ParticipantBackgroundColor #F4F8F6
skinparam ParticipantBorderColor #12805C
skinparam SequenceLifeLineBorderColor #9AA8A0
skinparam ActivityBackgroundColor #F4F8F6
skinparam ActivityBorderColor #12805C
skinparam NoteBackgroundColor #FFF6E5
skinparam NoteBorderColor #B7791F
skinparam EntityBackgroundColor #F4F8F6
skinparam EntityBorderColor #12805C
